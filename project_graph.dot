// LMArena Bridge - Project Architecture Graph
// Generated by opencode on 2026-07-31
// 
// To render this graph:
//   dot -Tpng project_graph.dot -o project_graph.png
//   dot -Tsvg project_graph.dot -o project_graph.svg
//   dot -Tpdf project_graph.dot -o project_graph.pdf
//
// Or use the interactive HTML version: project_graph.html

digraph LMArenaBridge {
    // Graph settings
    rankdir=TB;
    fontname="Arial";
    node [fontname="Arial", fontsize=10, shape=box, style=filled];
    edge [fontname="Arial", fontsize=8];
    bgcolor="white";
    
    // Title
    label="LMArena Bridge - Project Architecture\nOpenAI-compatible API bridge to LM Arena";
    labelloc=t;
    fontsize=16;
    fontname="Bold";
    
    // Main Entry Point
    main [label="main.py\n(FastAPI App\n~4700 lines)", fillcolor="#4CAF50", fontcolor=white];
    
    // Core Modules
    subgraph cluster_core {
        label="Core Modules (src/)";
        style=dashed;
        color=blue;
        fontsize=12;
        
        constants [label="constants.py\n(Hardcoded values\nURLs, selectors)", fillcolor="#E3F2FD"];
        config [label="config.py\n(Config I/O\nget_config, save_config)", fillcolor="#E3F2FD"];
        state [label="state.py\n(In-memory state\nchat sessions, tokens)", fillcolor="#E3F2FD"];
        auth [label="auth.py\n(Auth token management\nJWT, round-robin)", fillcolor="#E3F2FD"];
        recaptcha [label="recaptcha.py\n(reCAPTCHA v3/v2\nChrome/Camoufox)", fillcolor="#E3F2FD"];
        transport [label="transport.py\n(Transport layer\n4 fetch strategies)", fillcolor="#E3F2FD"];
        browser_utils [label="browser_utils.py\n(Browser utilities\nWindows/Playwright)", fillcolor="#E3F2FD"];
    }
    
    // Transport Strategies
    subgraph cluster_transport {
        label="Transport Strategies";
        style=dashed;
        color=orange;
        fontsize=12;
        
        httpx [label="Direct httpx\n(Standard async HTTP)", shape=ellipse, fillcolor="#FFF3E0"];
        chrome [label="Chrome fetch\n(Playwright browser\nfetch())", shape=ellipse, fillcolor="#FFF3E0"];
        camoufox [label="Camoufox fetch\n(Firefox-based\nfallback)", shape=ellipse, fillcolor="#FFF3E0"];
        userscript [label="Userscript proxy\n(Long-poll mechanism)", shape=ellipse, fillcolor="#FFF3E0"];
    }
    
    // External Components
    subgraph cluster_external {
        label="External Services";
        style=dashed;
        color=red;
        fontsize=12;
        
        lmarena [label="LM Arena\n(arena.ai)", shape=cylinder, fillcolor="#FFEBEE"];
        cloudflare [label="Cloudflare\n(Protection)", shape=cylinder, fillcolor="#FFEBEE"];
        recaptcha_ext [label="reCAPTCHA\n(Enterprise)", shape=cylinder, fillcolor="#FFEBEE"];
        supabase [label="Supabase\n(Auth backend)", shape=cylinder, fillcolor="#FFEBEE"];
    }
    
    // Frontend Components
    subgraph cluster_frontend {
        label="Frontend";
        style=dashed;
        color=purple;
        fontsize=12;
        
        dashboard [label="Dashboard\n(HTML/Chart.js\nAdmin UI)", fillcolor="#F3E5F5"];
        web [label="WEB/\n(React/Node.js\nFrontend)", fillcolor="#F3E5F5"];
    }
    
    // BOT Component
    subgraph cluster_bot {
        label="BOT";
        style=dashed;
        color=green;
        fontsize=12;
        
        bot [label="BOT/main.py\n(Telegram bot\nnotifications)", fillcolor="#E8F5E9"];
    }
    
    // DEPLOY Component
    subgraph cluster_deploy {
        label="DEPLOY";
        style=dashed;
        color=gray;
        fontsize=12;
        
        deploy [label="DEPLOY/\n(Cloudflared\nDeployment)", fillcolor="#ECEFF1"];
    }
    
    // Core Module Connections
    main -> config [label="loads"];
    main -> state [label="manages"];
    main -> auth [label="uses"];
    main -> transport [label="selects"];
    main -> recaptcha [label="mints tokens"];
    main -> dashboard [label="serves"];
    
    config -> constants [label="reads"];
    auth -> recaptcha [label="refreshes"];
    auth -> supabase [label="refreshes via"];
    
    // Transport Connections
    transport -> httpx [label="uses"];
    transport -> chrome [label="uses"];
    transport -> camoufox [label="uses"];
    transport -> userscript [label="uses"];
    
    // External Service Connections
    httpx -> lmarena [label="requests"];
    chrome -> lmarena [label="requests"];
    chrome -> cloudflare [label="bypasses"];
    camoufox -> lmarena [label="requests"];
    camoufox -> cloudflare [label="bypasses"];
    userscript -> lmarena [label="requests"];
    
    chrome -> recaptcha_ext [label="solves"];
    camoufox -> recaptcha_ext [label="solves"];
    
    // Frontend Connections
    web -> main [label="API calls"];
    bot -> main [label="monitors"];
    deploy -> main [label="deploys"];
    
    // Cross-module pattern
    subgraph cluster_pattern {
        label="Cross-module Pattern";
        style=dashed;
        color=brown;
        fontsize=12;
        
        m_func [label="_m()\n(Late import helper)", shape=ellipse, fillcolor="#FFF8E1"];
    }
    
    m_func -> main [label="imports"];
    auth -> m_func [label="uses"];
    recaptcha -> m_func [label="uses"];
    transport -> m_func [label="uses"];
}
